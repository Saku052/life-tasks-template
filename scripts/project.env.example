# scripts/bootstrap.sh が scripts/project.env を自動生成する。
# これはその形を示すサンプル。手で作る必要はない。
#
# 中身は Projects v2 のノードID・フィールドID・選択肢IDで、
# 秘密情報（トークン等）は含まれない。ただしアカウント固有の値なので追跡しない。

OWNER="your-github-account"
REPO="life"
PROJECT_NUMBER="1"
PROJECT_ID="PVT_xxxxxxxxxxxxxxxx"
PROJECT_URL="https://github.com/users/your-github-account/projects/1"

STATUS_FIELD_ID="PVTSSF_xxxxxxxxxxxxxxxx"
OPT_TODO="xxxxxxxx"
OPT_PENDING="xxxxxxxx"
OPT_INPROGRESS="xxxxxxxx"
OPT_DONE="xxxxxxxx"

PRIORITY_FIELD_ID="PVTSSF_xxxxxxxxxxxxxxxx"
PRIO_P0="xxxxxxxx"
PRIO_P1="xxxxxxxx"
PRIO_P2="xxxxxxxx"

DUE_FIELD_ID="PVTF_xxxxxxxxxxxxxxxx"
